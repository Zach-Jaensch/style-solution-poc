{
  "name": "@internal/css-modules-component-lib",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "styles.css"
  ],
  "exports": {
    "./styles.css": {
      "import": "./dist/styles.css"
    },
    "./styled": {
      "types": "./dist/types/react/styled/index.d.ts",
      "import": "./dist/esm/styled.mjs",
      "require": "./dist/cjs/styled.cjs"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/esm/theme.mjs",
      "require": "./dist/cjs/theme.cjs"
    },
    "./button": {
      "types": "./dist/types/react/button/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm package-bundler build-shared-ui",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "build:es": "tsc -p ./tsconfig.es.json",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "@kaizen/package-bundler": "^2.0.3",
    "@safetyculture/design-tokens": "3.1.1",
    "@types/node": "^20.14.13",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/styled-components": "^5.1.4",
    "classnames": "^2.5.1",
    "postcss": "^8.4.49",
    "postcss-preset-env": "^10.1.1",
    "react": "19.0.0-rc.0",
    "rollup": "^4.28.1",
    "styled-components": "5.3.0",
    "tslib": "^2.8.1",
    "typescript": "5.2.2"
  },
  "peerDependencies": {
    "react": "*",
    "styled-components": "5.3.0"
  }
}
